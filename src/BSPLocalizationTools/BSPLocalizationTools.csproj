<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>BSPLocalizationTools.GUI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot>true</PublishAot>
    <!--Native AOT size settings; kept here so they apply to every publish, profile or not.-->
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
    <StackTraceSupport>false</StackTraceSupport>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <!--No longer transitive via ReactiveUI.Avalonia 12; used for System.Reactive.Linq.-->
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BSPLocalizationToolsCore\BSPLocalizationToolsCore.csproj" />
  </ItemGroup>

  <!-- Resources.Designer.cs is generated at build time by ResxSourceGenerator,
       so it is not checked in and does not require Visual Studio. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="5.0.0-1.25277.114">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Lang\Resources.resx">
      <GenerateSource>true</GenerateSource>
      <Public>true</Public>
      <LogicalName>BSPLocalizationTools.GUI.Lang.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Lang\Resources.zh-CN.resx">
      <LogicalName>BSPLocalizationTools.GUI.Lang.Resources.zh-CN.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Lang\Resources.zh-TW.resx">
      <LogicalName>BSPLocalizationTools.GUI.Lang.Resources.zh-TW.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
